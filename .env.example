# Copy to .env (not committed) or set these as environment variables / IntelliJ run-configuration variables.
# Do not put a real password in this file.
BANK_DB_URL=jdbc:postgresql://localhost:5432/bank_test
BANK_DB_USER=bank
BANK_DB_PASSWORD=

# Integration tests wipe transfers and reset balances: point them at a dedicated database whose name ends with "_test".
# If these are not set, BANK_DB_* is used.
# BANK_TEST_DB_URL=jdbc:postgresql://localhost:5432/bank_test
# BANK_TEST_DB_USER=bank
# BANK_TEST_DB_PASSWORD=

# Optional. Instance identifier shown in logs and in the X-Instance-Id header (default: HOSTNAME / COMPUTERNAME).
# INSTANCE_ID=
# Optional. Internal management port (default 8081) and the wait for a DB connection (default 3000 ms).
# MANAGEMENT_SERVER_PORT=8081
# BANK_DB_CONNECTION_TIMEOUT_MS=3000

# Optional. Set to WARN to silence the per-request operation log lines (logger bank.operations).
# LOGGING_LEVEL_BANK_OPERATIONS=INFO

# Research profile only (SPRING_PROFILES_ACTIVE=research): enables POST /actuator/researchfault on the management port.
# SPRING_PROFILES_ACTIVE=research
